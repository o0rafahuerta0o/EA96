public static List<Integer> compareTriplets(List<Integer> a, List<Integer> b) {
        List<Integer> scores = new ArrayList<>();
        int Alicescore=0;
        int Bobscore=0;

        for (int i=0;i<a.size();i++){
            if (a.get(i)> b.get(i)){
                Alicescore += 1;
            }
            else if (b.get(i)>a.get(i)){
                Bobscore += 1;
            }
        }

        scores.add(Alicescore);
        scores.add(Bobscore);
        return scores;

    }
    }
